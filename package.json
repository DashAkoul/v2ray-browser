{
  "name": "v2ray-browser",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone Chrome/Firefox extension that manages V2Ray-style proxy configurations and routes browser traffic through user-supplied SOCKS/HTTP endpoints.",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "icons": "node scripts/generate-icons.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "npm run build:chrome && npm run build:firefox",
    "build:chrome": "node apps/extension/scripts/build.mjs chrome",
    "build:firefox": "node apps/extension/scripts/build.mjs firefox",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --output json",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/chrome": "^0.3.6",
    "@types/node": "^24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5",
    "web-ext": "10.8.0"
  }
}
